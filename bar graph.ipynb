    "import matplotlib.pyplot as plt\n",
    "students=[\"A\",\"B\",\"C\",\"D\",\"E\",\"F\"]\n",
    "marks=[50,67,78,83,93,100]\n",
    "plt.bar(students,marks,color=\"grey\",width=0.7,edgecolor=\"yellow\",label=\"stud\")\n",
    "plt.legend()\n",
    "plt.title(\"Students marks in semester\")\n",
    "plt.xlabel(\"Students\")\n",
    "plt.ylabel(\"Marks\")\n",
    "plt.show()\n"
   ]
